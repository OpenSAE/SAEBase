{
  "description": "Local file and shell authorization; development mode uses native client permissions and project path scope",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/tool_policy.py\"",
            "timeout": 15
          }
        ],
        "matcher": "^(Bash|apply_patch|Edit|Write|write_file|create_file|update_file|read_file|list_directory|view_image)$"
      }
    ]
  }
}
