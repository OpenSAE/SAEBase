  "entries": [
    {
      "term_id": "term.resnet18",
      "blocks": [
        {
          "type": "text",
          "label": "结构说明",
          "value": "ResNet-18 由残差模块堆叠构成。主分支与捷径分支相加，尺寸变化时可采用投影捷径。当前项目通过 torchvision.models.resnet18 创建主干。",
          "source": "doc/knowledge/foundations/model.md"
        },
        {
          "type": "formula",
          "label": "残差连接的概念表达",
          "value": "y = F(x; W) + x",
          "source": "doc/knowledge/foundations/model.md",
          "note": "概念式；尺寸变化的模块可能使用投影捷径。"
        },
        {
          "type": "diagram",
          "label": "残差结构示意",
          "diagram": "residual",
          "caption": "输入沿主干变换与捷径传递，最后相加。仅为架构示意。",
          "source": "doc/knowledge/foundations/model.md"
        },
        {
          "type": "code",
          "label": "项目中调用 ResNet-18 的源码",
          "value": "self.resnet18 = models.resnet18(weights=ResNet18_Weights.IMAGENET1K_V1)",
          "source": "models/vision/resnet18_mlp/resnet18_mlp.py"
        }
      ]
    },
    {
      "term_id": "term.cub200",
      "blocks": [
        {
          "type": "text",
          "label": "当前数据范围",
          "value": "当前实现读取 CUB-200-2011 鸟类图像、类别和官方训练/测试划分。独立验证集由额外的数据划分配置建立。",
          "source": "doc/knowledge/foundations/dataset.md"
        },
        {
          "type": "diagram",
          "label": "官方数据划分示意",
          "diagram": "cub_split",
          "caption": "官方训练数据用于模型开发，官方测试数据用于最终评测。",
          "source": "doc/knowledge/foundations/dataset.md"
        },
        {
          "type": "reference",
          "label": "数据读取代码",
          "path": "datasets/vision/CUB_200/CUB_200.py"
        }
      ]
    },
    {
      "term_id": "term.classification_head",
      "blocks": [
        {
          "type": "text",
          "label": "在当前模型中的位置",
          "value": "线性分类头接收 ResNet 最后的视觉特征并输出每一类的原始得分。MLP 模式则走另一个已有分类头。",
          "source": "doc/knowledge/foundations/model.md"
        },
        {
          "type": "code",
          "label": "线性分类头实现",
          "value": "self.resnet18.fc = nn.Linear(in_features, int(output_size))",
          "source": "models/vision/resnet18_mlp/resnet18_mlp.py"
        }
      ]
    },
    {
      "term_id": "term.logits",
      "blocks": [
        {
          "type": "formula",
          "label": "将 logits 转为概率的定义",
          "value": "pᵢ = exp(zᵢ) / Σⱼ exp(zⱼ)",
          "source": "doc/knowledge/foundations/model.md",
          "note": "模型直接产生 z，概率是之后的 softmax 结果。"
        },
        {
          "type": "text",
          "label": "使用方式",
          "value": "分类训练中的交叉熵直接接收模型输出的原始类别得分 logits。",
          "source": "doc/knowledge/foundations/training.md"
        },
        {
          "type": "code",
          "label": "分类损失实际代码",
          "value": "loss = F.cross_entropy(logits, y, label_smoothing=self._label_smoothing)",
          "source": "tasks/vision/classification/classification_module.py"
        }
      ]
    },
    {
      "term_id": "term.cross_entropy",
      "blocks": [
        {
          "type": "formula",
          "label": "标准单标签交叉熵",
          "value": "L = −log(pᵧ)",
          "source": "doc/knowledge/foundations/training.md",
          "note": "此式为标准单标签交叉熵基本形式，当前训练还支持 label smoothing。"
        },
        {
          "type": "code",
          "label": "现有交叉熵实现",
          "value": "loss = F.cross_entropy(logits, y, label_smoothing=self._label_smoothing)",
          "source": "tasks/vision/classification/classification_module.py"
        }
      ]
    },
