{
  "version": 2,
  "punctuation_rules": {
    "punctuation": "\\bpunctuation\\b",
    "colon_semicolon": "\\b(?:colons?|semicolons?)\\b",
    "comma": "\\bcommas?\\b",
    "apostrophe": "\\bapostrophes?\\b",
    "quotation_marks": "\\b(?:quotation marks?|quote marks?|double quotes?|single quotes?|inverted commas?)\\b",
    "parentheses_brackets": "\\b(?:parentheses|parenthesis|parenthetical|brackets?)\\b",
    "hyphen_dash": "\\b(?:hyphens?|em[ -]?dashes?|en[ -]?dashes?)\\b",
    "ellipsis": "\\b(?:ellipsis|ellipses)\\b",
    "question_exclamation_marks": "\\b(?:question marks?|exclamation (?:marks?|points?))\\b",
    "full_stop_period": "\\bfull stops?\\b|\\b(?:sentence[- ]ending|punctuation) periods?\\b|\\bperiods? (?:as punctuation|at the end of sentences)\\b",
    "sentence_boundary": "\\bsentence (?:boundaries|endings?|termination)\\b|\\bend[- ]of[- ]sentence (?:markers?|punctuation)\\b",
    "syntax_braces_slash": "\\b(?:braces?|slashes?|dashes?)\\b.{0,60}\\b(?:punctuation|syntax|delimiters?|text|sentences?)\\b|\\b(?:punctuation|syntax|delimiters?)\\b.{0,60}\\b(?:braces?|slashes?|dashes?)\\b"
  },
  "structural_rules": {
    "function_word_class": "\\b(?:prepositions?|pronouns?|conjunctions?|determiners?|function words?|auxiliary verbs?|modal verbs?)\\b",
    "grammatical_article": "\\b(?:definite|indefinite) articles?\\b|\\barticles? (?:and|or) (?:prepositions?|pronouns?|determiners?)\\b",
    "natural_language_grammar": "\\b(?:grammar|grammatical|syntactic|syntax|parts? of speech)\\b",
    "sentence_structure": "\\bsentence (?:structures?|construction|patterns?)\\b|\\b(?:relative|subordinate|subordinating|main|adverbial|conditional) clauses?\\b",
    "verb_morphology": "\\b(?:verb tenses?|past tense|present tense|future tense|perfect tense|conjugations?|inflections?|subject[- ]verb agreement)\\b|\\bforms? of (?:the )?verb\\s+[\\\"\\u201c\\u2018\\x27]?(?:to\\s+)?(?:be|have|do)\\b",
    "generic_question_form": "\\b(?:interrogative|question forms?|question structures?|question phrases?|yes[- ]no questions?|rhetorical questions?)\\b|\\bquestions? (?:in|and) dialogue\\b",
    "reported_speech_structure": "\\b(?:reported speech|direct speech|indirect speech|quotative constructions?)\\b",
    "layout_only": "\\b(?:whitespace|white space|line breaks?|newlines?|indentation)\\b"
  },
