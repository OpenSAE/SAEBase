include README.md README_cn.md LICENSE CITATION.cff
include requirements.txt
recursive-include .github *.yml *.md
recursive-include conf *.yaml *.md *.json
recursive-include doc/code/development *.md *.json *.cff NOTICE
recursive-include saebase *.md
include tests/__init__.py
recursive-include tests/product *.py
recursive-include tests/product/fixtures *.json
recursive-include tests/fixtures *.py
recursive-include scripts/examples *.py
recursive-include scripts *.py
prune data
prune experiment
prune .venv
# Frozen historical files are Git/Release records, never package requirements.
prune doc/code/development/archive
prune tests/product/archive
global-exclude __pycache__ *.py[cod] .DS_Store

# Stage D evidence lives in Git and the dedicated evidence release, not in pip packages.
recursive-exclude conf/coverage/stage_d_evidence *

recursive-include datasets *.py
recursive-include saebase/research_lab *.html *.css *.js *.json
recursive-include doc/code/assets *.svg *.png
