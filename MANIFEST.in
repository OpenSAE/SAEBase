include README.md README_cn.md LICENSE CITATION.cff
include requirements.txt
recursive-include .github *.yml *.md
recursive-include conf *.yaml *.md *.json
recursive-include harness/github_development_doc *.md *.json *.cff NOTICE
recursive-include saebase *.md
recursive-include harness/github_work_test *.py
recursive-include harness/github_work_test/fixtures *.json
recursive-include saebase/examples *.py *.sh
recursive-include saebase/tools *.py
prune data
prune experiment
prune .venv
global-exclude __pycache__ *.py[cod] .DS_Store

# Stage D evidence lives in Git and the dedicated evidence release, not in pip packages.
recursive-exclude conf/coverage/stage_d_evidence *

recursive-include datasets *.py
recursive-include saebase/research_lab *.html *.css *.js *.json

recursive-include experiments *.py *.md *.json
recursive-include scripts *.sh
