{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python .cursor/hooks/guard_paths.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/guard_shell.py"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python .cursor/hooks/validate_change.py"
      }
    ]
  }
}
